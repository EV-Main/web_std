      { "chord": "S", "label": "cache", "scope": false },
      { "chord": "G", "label": "go", "scope": true },
      { "chord": "1", "label": "one", "scope": false }
    ] } },
    { "why": "Esc closes an open scope, and only an open one", "keys": ["Alt+s", "Escape", "Escape"], "steps": ["opened", "closed", "pass"] },
