    { "why": "ЙЦУКЕН: the Latin label printed on the key", "keys": [{ "key": "ы", "code": "KeyS", "alt": true }, { "key": "г", "code": "KeyU" }], "steps": ["opened", "run undo: Alt+S U"] },
