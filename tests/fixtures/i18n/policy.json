  ],
  "audit": [
    {
      "catalogues": [["ru", ["New"], { "New": "Новое" }, { "Old": "Старое" }]],
      "floor": 1,
      "ok": false,
      "report": "FAIL ru  100% coverage\n       Old  [orphan-override] the code no longer renders \"Old\""
    },
    {
      "catalogues": [["ru", ["New"], { "New": "Новое" }, {}]],
      "floor": 1,
      "ok": true,
      "report": "ok   ru  100% coverage"
    },
    {
      "catalogues": [["ru", ["A", "B"], { "A": "А" }, {}]],
      "floor": 0.5,
      "ok": true,
      "report": "ok   ru  50% coverage\n       untranslated (1): B"
    },
    {
      "catalogues": [["ru", ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l"], {}, {}], ["vi", ["a"], { "a": "y" }, {}]],
      "floor": 1,
      "ok": false,
      "report": "FAIL ru  0% coverage\n       untranslated (12): a, b, c, d, e, f, g, h, i, j\n       …and 2 more\nok   vi  100% coverage"
