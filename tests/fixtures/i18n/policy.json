{
  "_": "The translation-policy contract both @evinvest/i18n/policy and ev_lib::i18n::policy run. A message's id is its English, or ctx + U+0004 + English. Catalogue keys are in byte order: Rust keeps catalogues sorted, TS in insertion order. resolve: one resolveCatalogue call over the ids the code renders, the generated catalogue and the overrides; rejected as [key, reason, detail]; audit: [locale, source ids, auto, overrides] per resolved catalogue → the CI report; available: [locale, [name, locales][], policy, names shown].",
  "resolve": [
    {
      "locale": "en",
      "source": ["A"],
      "auto": {},
      "overrides": {},
      "messages": { "A": "A" },
      "rejected": [],
      "missing": [],
      "coverage": 1
    },
    {
      "locale": "en",
      "source": ["tab\u0004A"],
      "auto": {},
      "overrides": {},
      "messages": { "tab\u0004A": "A" },
      "rejected": [],
      "missing": [],
      "coverage": 1
    },
    {
      "locale": "ru",
      "source": ["Coastal Vietnam"],
