// Generated by ev_lib::api::rust_client from the service's document.

impl Client {
	/// Every note.
	///
	/// `GET /notes`
	pub async fn list_notes(&self, since: Option<&str>) -> Result<Vec<crate::dto::Note>, Error> {
		let req = self.request(reqwest::Method::GET, "/notes")?.query(&{
			#[derive(serde::Serialize)]
			struct Query<'a> {
				#[serde(skip_serializing_if = "Option::is_none")]
				since: Option<&'a str>,
			}
			Query { since }
		});
		let res = Self::send(req).await?;
		Ok(res.json().await?)
	}

	/// A note.
	///
	/// `GET /notes/{id}`
	pub async fn get_note(&self, id: i64) -> Result<crate::dto::Note, Error> {
		let req = self.request(reqwest::Method::GET, &format!("/notes/{}", id))?;
		let res = Self::send(req).await?;
		Ok(res.json().await?)
	}

	/// Writes a note.
	///
	/// `PUT /notes/{id}`
	pub async fn put_note(&self, id: i64, body: &crate::dto::Note) -> Result<crate::dto::Note, Error> {
		let req = self.request(reqwest::Method::PUT, &format!("/notes/{}", id))?.json(body);
		let res = Self::send(req).await?;
		Ok(res.json().await?)
	}
}
